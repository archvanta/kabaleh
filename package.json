{
  "name": "meshkat-letter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/content.test.ts",
    "test:e2e": "playwright test",
    "build:personal": "MESHKAT_PERSONAL_PREVIEW=1 next build",
    "preview:personal": "npm run build:personal && MESHKAT_PERSONAL_PREVIEW=1 node scripts/serve.mjs",
    "models:export": "tsx scripts/export-models.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.2.8",
    "lucide-react": "0.577.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.183.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.1"
}
